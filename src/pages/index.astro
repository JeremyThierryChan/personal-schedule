---
import '../styles/global.css';
import scheduleData from '../data/schedule.json';
import visitorsData from '../data/visitors.json';
import contactData from '../data/contact.json';
import settingsData from '../data/settings.json';
import { beijingTodayKey, computeRange, formatDateLabel, type BusyEntry, type RestWindow } from '../lib/schedule';
import type { Visitor } from '../lib/access';

// 一天的范围：默认整天 00:00–23:59，若数据里真有超出范围的安排会自动扩展（不会裁掉）
const schedule = scheduleData as BusyEntry[];
const range = computeRange(schedule);

// 每天的休息时段（默认 22:00 → 次日 08:00）：用另一种颜色显示，且不算空闲
const rest: RestWindow | undefined =
  settingsData.restStart && settingsData.restEnd
    ? { start: settingsData.restStart, end: settingsData.restEnd }
    : undefined;

// 日程数据是北京时间的，所以「今天」也用北京时间（页面加载后由浏览器端再算一次）
const today = beijingTodayKey();

// 预约联系方式：改 src/data/contact.json
const contact = contactData;
const hasPrices = Array.isArray(contact.prices) && contact.prices.length > 0;
if (contact.phone.includes('0000') || contact.wechat.includes('你的')) {
  console.warn('⚠️ src/data/contact.json 里还是占位内容，记得填上真实的电话和微信号');
}

// 把数据内嵌进页面，交给浏览器端渲染（静态站点，没有后端）
const appData = JSON.stringify({
  schedule,
  visitors: visitorsData as Visitor[],
  range,
  rest,
}).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Personal Schedule · 我的时间表</title>
    <meta name="description" content="个人时间表：查看我的忙碌与空闲时间" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🗓️</text></svg>" />
  </head>

  <body class="min-h-screen">
    <!-- 手机 / 平板：居中窄栏；桌面（lg 以上）：铺满整个屏幕宽度 -->
    <main class="mx-auto w-full max-w-2xl px-4 py-10 sm:py-16 lg:max-w-none lg:px-8 xl:px-12">
      <!-- 标题 -->
      <header class="mb-6 flex flex-wrap items-end justify-between gap-2 lg:mb-8">
        <div>
          <h1 class="text-2xl font-semibold tracking-tight text-slate-900 sm:text-3xl">Personal Schedule</h1>
          <p class="mt-1 text-sm text-slate-500">
            今天是 <span id="today-line" class="font-medium text-slate-700">{formatDateLabel(today)}</span>
            <span class="ml-1 text-slate-400">· 北京时间</span>
          </p>
        </div>
      </header>

      <!-- 姓名验证（可选）：默认只显示一个入口条，不挡着时间表 -->
      <section class="mb-5">
        <!-- 访客视图 -->
        <div
          id="auth-guest"
          class="flex flex-wrap items-center justify-between gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2 shadow-sm"
        >
          <span id="guest-hint" class="text-xs text-slate-500">访客视图 · 只显示忙碌 / 空闲</span>
          <button
            id="auth-toggle"
            type="button"
            class="rounded-lg px-2.5 py-1.5 text-xs font-medium text-slate-700 ring-1 ring-slate-200 transition-colors hover:bg-slate-100"
          >
            🔒 输入姓名
          </button>
        </div>

        <!-- 展开的输入框 -->
        <form
          id="name-form"
          hidden
          novalidate
          class="rounded-xl border border-slate-200 bg-white p-3 shadow-sm"
        >
          <label for="name-input" class="block text-xs font-medium text-slate-600">
            输入姓名以查看具体日程
          </label>
          <div class="mt-2 flex flex-col gap-2 sm:flex-row">
            <input
              id="name-input"
              name="name"
              type="text"
              autocomplete="name"
              placeholder="例如：Alice"
              class="w-full flex-1 rounded-lg border border-slate-300 bg-white px-3 py-2 text-base text-slate-900 placeholder:text-slate-400 focus:border-slate-400 focus:ring-2 focus:ring-slate-200 focus:outline-none"
            />
            <div class="flex gap-2">
              <button
                type="submit"
                class="flex-1 shrink-0 rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-slate-300 focus:outline-none"
              >
                查看详细日程
              </button>
              <button
                id="auth-cancel"
                type="button"
                class="shrink-0 rounded-lg px-3 py-2 text-sm text-slate-500 transition-colors hover:bg-slate-100"
              >
                取消
              </button>
            </div>
          </div>
          <p id="name-error" hidden class="mt-2 text-xs text-rose-600"></p>
        </form>

        <!-- 已授权 -->
        <div
          id="auth-full"
          hidden
          class="flex flex-wrap items-center justify-between gap-2 rounded-xl border border-emerald-200 bg-emerald-50 px-3 py-2"
        >
          <span class="text-xs font-medium text-emerald-700">✓ 已授权 · 可以看到具体日程</span>
          <button
            id="auth-exit"
            type="button"
            class="rounded-lg px-2.5 py-1 text-xs text-emerald-700 transition-colors hover:bg-emerald-100"
          >
            退出
          </button>
        </div>
      </section>


      <!-- 时间表：打开页面就能看到 -->
      <section id="result">
        <!-- 视图切换 -->
        <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
          <div class="inline-flex rounded-xl bg-slate-100 p-1">
            <button data-view="day" type="button" class="rounded-lg px-4 py-1.5 text-sm font-medium">日</button>
            <button data-view="week" type="button" class="rounded-lg px-4 py-1.5 text-sm font-medium">周</button>
            <button data-view="month" type="button" class="rounded-lg px-4 py-1.5 text-sm font-medium">月</button>
          </div>
          <!-- 颜色说明 -->
          <div class="flex items-center gap-3 text-[11px] text-slate-500">
            <span class="inline-flex items-center gap-1.5">
              <span class="h-3 w-3 rounded bg-rose-100 ring-1 ring-rose-300"></span>忙碌
            </span>
            {
              rest && (
                <span class="inline-flex items-center gap-1.5">
                  <span class="h-3 w-3 rounded bg-indigo-100 ring-1 ring-indigo-200" />休息
                </span>
              )
            }
            <span class="inline-flex items-center gap-1.5">
              <span class="h-3 w-3 rounded bg-emerald-50 ring-1 ring-emerald-200"></span>空闲
            </span>
          </div>
        </div>

        <!-- 日期切换 -->
        <div class="mb-3 flex items-center justify-between gap-2 rounded-2xl border border-slate-200 bg-white p-2 shadow-sm">
          <button
            id="prev-day"
            type="button"
            aria-label="前一天"
            class="rounded-xl px-3 py-2 text-sm font-medium text-slate-600 transition-colors hover:bg-slate-100"
          >
            ←
          </button>

          <div id="nav-day" class="flex min-w-0 flex-col items-center">
            <input
              id="date-picker"
              type="date"
              aria-label="选择日期"
              class="w-[9.5rem] rounded-lg bg-transparent text-center font-mono text-sm tabular-nums text-slate-900 focus:ring-2 focus:ring-slate-200 focus:outline-none"
            />
            <span id="date-label" class="mt-0.5 text-xs text-slate-400"></span>
          </div>

          <div id="nav-range" hidden class="flex min-w-0 flex-col items-center">
            <span id="range-label" class="font-mono text-sm tabular-nums text-slate-900"></span>
            <span id="range-sub" class="mt-0.5 text-center text-xs text-slate-400"></span>
          </div>

          <button
            id="next-day"
            type="button"
            aria-label="后一天"
            class="rounded-xl px-3 py-2 text-sm font-medium text-slate-600 transition-colors hover:bg-slate-100"
          >
            →
          </button>
        </div>

        <button
          id="today-button"
          type="button"
          hidden
          class="mb-3 w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-medium text-slate-500 transition-colors hover:bg-slate-100"
        >
          回到今天
        </button>

        <p id="notice" class="hidden"></p>

        <!-- 日视图：时间轴网格（方块高度 = 占用时间） -->
        <div id="day-view" class="rounded-2xl border border-slate-200 bg-white px-1 py-3 shadow-sm sm:px-2"></div>

        <!-- 周视图：7 天横向铺开的时间轴网格 -->
        <div id="week-view" hidden class="rounded-2xl border border-slate-200 bg-white px-1 py-3 shadow-sm sm:px-2"></div>

        <!-- 月视图 -->
        <div id="month-view" hidden class="rounded-2xl border border-slate-200 bg-white p-2 shadow-sm sm:p-3">
          <div class="mb-1 grid grid-cols-7 gap-1">
            <span class="py-1 text-center text-[10px] font-medium text-slate-400 sm:text-xs">一</span>
            <span class="py-1 text-center text-[10px] font-medium text-slate-400 sm:text-xs">二</span>
            <span class="py-1 text-center text-[10px] font-medium text-slate-400 sm:text-xs">三</span>
            <span class="py-1 text-center text-[10px] font-medium text-slate-400 sm:text-xs">四</span>
            <span class="py-1 text-center text-[10px] font-medium text-slate-400 sm:text-xs">五</span>
            <span class="py-1 text-center text-[10px] font-medium text-slate-400 sm:text-xs">六</span>
            <span class="py-1 text-center text-[10px] font-medium text-slate-400 sm:text-xs">日</span>
          </div>
          <div id="month-grid" class="grid grid-cols-7 gap-1"></div>
        </div>
      </section>

      <!-- 预约我的时间（放在页面最下面）：原生 <details>，不需要 JS -->
      <details
        id="booking"
        class="group mt-5 overflow-hidden rounded-2xl border border-emerald-200 bg-emerald-50/70 shadow-sm"
      >
        <summary
          class="flex cursor-pointer list-none items-center justify-between gap-2 px-4 py-3 transition-colors hover:bg-emerald-100/70 [&::-webkit-details-marker]:hidden"
        >
          <span class="flex items-center gap-2 text-sm font-semibold text-emerald-800 sm:text-base">
            📅 {contact.heading}
          </span>
          <span class="shrink-0 text-xs text-emerald-600">
            <span class="group-open:hidden">展开 ▾</span>
            <span class="hidden group-open:inline">收起 ▴</span>
          </span>
        </summary>

        <div class="border-t border-emerald-200 bg-white px-4 py-4">
          {contact.intro && <p class="text-sm text-slate-600">{contact.intro}</p>}

          <!-- 联系方式 -->
          <div class="mt-3 divide-y divide-slate-100 border-y border-slate-100">
            {
              contact.phone && (
                <div class="flex items-center justify-between gap-3 py-2.5">
                  <div class="min-w-0">
                    <div class="text-xs text-slate-400">电话</div>
                    <a
                      href={`tel:${contact.phone.replace(/[^\d+]/g, '')}`}
                      class="font-mono text-sm font-medium text-slate-900 tabular-nums underline decoration-dotted underline-offset-4"
                    >
                      {contact.phone}
                    </a>
                  </div>
                  <button
                    type="button"
                    data-copy={contact.phone}
                    class="shrink-0 rounded-lg px-2.5 py-1.5 text-xs font-medium text-slate-600 ring-1 ring-slate-200 transition-colors hover:bg-slate-100"
                  >
                    复制
                  </button>
                </div>
              )
            }
            {
              contact.wechat && (
                <div class="flex items-center justify-between gap-3 py-2.5">
                  <div class="min-w-0">
                    <div class="text-xs text-slate-400">微信</div>
                    <div class="truncate font-mono text-sm font-medium text-slate-900">{contact.wechat}</div>
                  </div>
                  <button
                    type="button"
                    data-copy={contact.wechat}
                    class="shrink-0 rounded-lg px-2.5 py-1.5 text-xs font-medium text-slate-600 ring-1 ring-slate-200 transition-colors hover:bg-slate-100"
                  >
                    复制
                  </button>
                </div>
              )
            }
          </div>

          {
            contact.wechatQr && (
              <div class="mt-3 flex items-center gap-3">
                <img
                  src={contact.wechatQr}
                  alt="微信二维码"
                  class="h-28 w-28 shrink-0 rounded-lg border border-slate-200 object-contain"
                />
                <p class="text-xs text-slate-400">扫码加我微信</p>
              </div>
            )
          }

          <!-- 时段价格 -->
          {
            hasPrices && (
              <div class="mt-4">
                <div class="text-xs font-medium text-slate-500">时段价格</div>
                <div class="mt-1 divide-y divide-slate-100">
                  {contact.prices.map((item) => (
                    <div class="flex items-baseline justify-between gap-3 py-2">
                      <span class="text-sm text-slate-600">{item.label}</span>
                      <span class="shrink-0 text-sm font-semibold text-slate-900 tabular-nums">{item.price}</span>
                    </div>
                  ))}
                </div>
              </div>
            )
          }

          {contact.note && <p class="mt-3 text-xs leading-relaxed text-slate-400">{contact.note}</p>}
        </div>
      </details>

      <footer class="mt-10 border-t border-slate-200 pt-4 text-xs leading-relaxed text-slate-400">
        <p>静态网站，姓名仅用于前端显示控制，不要在此放置敏感信息。</p>
      </footer>
    </main>

    <!-- 内嵌数据：改 src/data/*.json 即可 -->
    <script type="application/json" id="app-data" is:inline set:html={appData}></script>

    <script>
      import { initApp } from '../scripts/app';
      initApp();
    </script>
  </body>
</html>
